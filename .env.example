# Public Supabase project settings (included in browser builds).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Temporary fallback for older projects; omit when the publishable key is set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=legacy_anon_jwt_replace_me

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=server_only_replace_me
CRON_SECRET=server_only_replace_me
SITEGUARD_DEMO_ORIGIN=https://your-siteguard.example.com
MONITOR_ALLOWLIST_HOSTS=your-siteguard.example.com
SITEGUARD_LLM_BASE_URL=https://your-llm-gateway.example.com/v1
SITEGUARD_LLM_API_KEY=server_only_replace_me
SITEGUARD_LLM_MODEL=your-model-id

# Optional server-only settings.
# NEATLOGS_API_KEY=server_only_replace_me
# MONITOR_TIMEOUT_MS=8000
# SUPABASE_DB_URL=postgresql://user:password@host:5432/database

# Optional disposable integration-test user; keep real values only in .env.local.
# SITEGUARD_TEST_EMAIL=test-user@example.com
# SITEGUARD_TEST_PASSWORD=replace_me
